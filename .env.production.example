# Copy to .env.production and fill in real values before deploying.

# Django
SECRET_KEY=generate-with-python-secrets-token-hex-50
DEBUG=false
DATABASE_URL=postgres://recipes_user:STRONG_PASSWORD@db:5432/recipes
ALLOWED_HOSTS=bitstream.mywire.org
POSTGRES_PASSWORD=STRONG_PASSWORD

# Required for Django admin + CSRF over HTTPS
CSRF_TRUSTED_ORIGINS=https://bitstream.mywire.org

# AI — leave blank if using Ollama or another provider via the UI
ANTHROPIC_API_KEY=sk-ant-...

# Django settings module
DJANGO_SETTINGS_MODULE=config.settings.production
